if (CMAKE_VERSION VERSION_LESS 3.22)
  message (FATAL_ERROR "CMake >= 3.22 required")
endif (CMAKE_VERSION VERSION_LESS 3.22)

@PACKAGE_INIT@

list (APPEND CMAKE_MODULE_PATH ${CMAKE_CURRENT_LIST_DIR})

include (CMakeFindDependencyMacro)

# The dependency integer size must match the installed headers and libraries.
if (DEFINED BLA_SIZEOF_INTEGER AND
    NOT BLA_SIZEOF_INTEGER EQUAL @BLA_SIZEOF_INTEGER@)
  set (SuiteSparse_FOUND FALSE)
  set (SuiteSparse_NOT_FOUND_MESSAGE
    "BLAS integer size mismatch: actual ${BLA_SIZEOF_INTEGER}, expected @BLA_SIZEOF_INTEGER@")
  return ()
endif (DEFINED BLA_SIZEOF_INTEGER AND
    NOT BLA_SIZEOF_INTEGER EQUAL @BLA_SIZEOF_INTEGER@)

# Keep the integer size local even when find_dependency returns early.
function (_SuiteSparse_find_blas_dependencies)
  set (BLA_SIZEOF_INTEGER @BLA_SIZEOF_INTEGER@)
  foreach (_dependency BLAS LAPACK)
    set (SuiteSparse_FOUND FALSE PARENT_SCOPE)
    set (SuiteSparse_NOT_FOUND_MESSAGE
      "SuiteSparse requires ${_dependency} with @BLA_SIZEOF_INTEGER@-byte integers"
      PARENT_SCOPE)
    find_dependency (${_dependency})
  endforeach (_dependency)
  set (SuiteSparse_FOUND TRUE PARENT_SCOPE)
  unset (SuiteSparse_NOT_FOUND_MESSAGE PARENT_SCOPE)
endfunction (_SuiteSparse_find_blas_dependencies)

_SuiteSparse_find_blas_dependencies ()
if (NOT SuiteSparse_FOUND)
  return ()
endif (NOT SuiteSparse_FOUND)
@CUDA_DEPENDENCY@
@METIS_DEPENDENCY@
@OpenMP_DEPENDENCY@
@TBB_DEPENDENCY@

# Add the targets after the dependecies were found since SuiteSparse targets
# depend on the external targets.
include ("${CMAKE_CURRENT_LIST_DIR}/suitesparse-targets.cmake")

set (_SuiteSparse_NAMESPACE "@SuiteSparse_NAMESPACE@")

foreach (_comp ${SuiteSparse_FIND_COMPONENTS})
  set (_TARGET ${_SuiteSparse_NAMESPACE}${_comp})

  if (TARGET ${_TARGET})
    set (SuiteSparse_${_comp}_FOUND TRUE)
  else (TARGET ${_TARGET})
    set (SuiteSparse_${_comp}_FOUND FALSE)
    set (SuiteSparse_NOT_FOUND_MESSAGE "SuiteSparse could not be found because the component ${_comp} could not be found.")
  endif (TARGET ${_TARGET})
endforeach (_comp)

check_required_components (SuiteSparse)
